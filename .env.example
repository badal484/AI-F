# ── Database (Supabase Postgres via Prisma driver adapter) ──────────────────
# Prisma 7 connects through @prisma/adapter-pg (node-postgres) for both the
# app runtime and `prisma migrate`, so use the direct/session connection
# string (not the pgbouncer transaction pooler, which doesn't support the
# session-level features Migrate needs).
# Supabase dashboard → Project Settings → Database → Connection string → "Session" / direct.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── Supabase Auth / Storage ──────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_PUBLIC_KEY]"
# Server-only — bypasses Row Level Security. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ── Redis / BullMQ (apps/worker) ────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: Upstash Redis connection string (Upstash dashboard → Redis → Connect → ioredis).
REDIS_URL="redis://localhost:6379"

# ── AI (Vercel AI SDK — packages/ai) ────────────────────────────────────────
# Chat: set ANTHROPIC_API_KEY (default provider, see packages/ai/src/provider.ts)
# or OPENAI_API_KEY — if only OPENAI_API_KEY is set, AI_MODEL becomes required
# (no OpenAI chat-model default is assumed).
ANTHROPIC_API_KEY="[ANTHROPIC_API_KEY]"
# Optional — overrides the default chat model. Required for chat if using OPENAI_API_KEY instead.
# AI_MODEL="claude-sonnet-5"

# Embeddings (RAG — packages/ai/src/rag) ALWAYS need this specifically,
# regardless of which provider is set above for chat — Anthropic has no
# public embeddings API. Uses text-embedding-3-small (1536 dims, see
# packages/db/prisma/schema.prisma's DocumentChunk.embedding column).
OPENAI_API_KEY="[OPENAI_API_KEY]"

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="info"
