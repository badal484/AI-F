# ── Database (Supabase Postgres via Prisma driver adapter) ──────────────────
# Prisma 7 connects through @prisma/adapter-pg (node-postgres) for both the
# app runtime and `prisma migrate`, so use the direct/session connection
# string (not the pgbouncer transaction pooler, which doesn't support the
# session-level features Migrate needs).
# Supabase dashboard → Project Settings → Database → Connection string → "Session" / direct.
# Local dev alternative: `docker compose up -d postgres` (docker-compose.yml,
# Phase 15), then DATABASE_URL="postgresql://aif:aif@localhost:5432/aif".
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── Seed script (packages/db/prisma/seed.ts, `npm run db:seed`) ─────────────
# Optional — only needed to have the seed script also provision a
# PlatformAdmin row. Unlike everything else the seed script creates, a
# PlatformAdmin must reference a REAL Supabase auth user id (same rule as
# User.supabaseUserId) — it can't be fabricated, so the seed script skips
# this step entirely (logged, not silently faked) when these are unset.
# Create the Supabase user first (dashboard or `auth.admin.createUser`),
# then set its id here.
SEED_PLATFORM_ADMIN_SUPABASE_USER_ID="[SUPABASE_AUTH_USER_ID]"
SEED_PLATFORM_ADMIN_EMAIL="[PLATFORM_ADMIN_EMAIL]"

# ── Supabase Auth / Storage ──────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_PUBLIC_KEY]"
# Server-only — bypasses Row Level Security. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ── Redis / BullMQ (packages/queue) ──────────────────────────────────────────
# Used by both apps/worker (registers the queues) and apps/web (enqueues jobs
# — the WhatsApp webhook route, and sendMessage for WhatsApp conversations).
# Local dev: redis://localhost:6379
# Production: Upstash Redis connection string (Upstash dashboard → Redis → Connect → ioredis).
REDIS_URL="redis://localhost:6379"

# ── AI (Vercel AI SDK — packages/ai) ────────────────────────────────────────
# Chat: set ANTHROPIC_API_KEY (default provider, see packages/ai/src/provider.ts)
# or OPENAI_API_KEY — if only OPENAI_API_KEY is set, AI_MODEL becomes required
# (no OpenAI chat-model default is assumed).
ANTHROPIC_API_KEY="[ANTHROPIC_API_KEY]"
# Optional — overrides the default chat model. Required for chat if using OPENAI_API_KEY instead.
# AI_MODEL="claude-sonnet-5"

# Embeddings (RAG — packages/ai/src/rag) ALWAYS need this specifically,
# regardless of which provider is set above for chat — Anthropic has no
# public embeddings API. Uses text-embedding-3-small (1536 dims, see
# packages/db/prisma/schema.prisma's DocumentChunk.embedding column).
OPENAI_API_KEY="[OPENAI_API_KEY]"

# ── WhatsApp Cloud API (Meta) — packages/whatsapp ───────────────────────────
# One platform-level Meta app/access token sends on behalf of every tenant's
# own WhatsApp number — each Tenant's specific number is set separately, in
# its own Settings page (Tenant.whatsappPhoneNumberId), not here.
# Meta for Developers → your app → WhatsApp → API Setup → System User access token.
WHATSAPP_ACCESS_TOKEN="[WHATSAPP_ACCESS_TOKEN]"
# Meta for Developers → your app → Settings → Basic → App Secret. Used to verify
# the X-Hub-Signature-256 header on every inbound webhook — this is what makes
# it safe to trust a webhook's claimed tenant without a logged-in session.
WHATSAPP_APP_SECRET="[WHATSAPP_APP_SECRET]"
# A string you make up yourself and enter in Meta's webhook configuration
# screen — confirms the GET verification handshake when you first register
# the webhook URL (apps/web's /api/webhooks/whatsapp).
WHATSAPP_VERIFY_TOKEN="[WHATSAPP_VERIFY_TOKEN]"
# Optional — overrides the Graph API version used for outbound sends.
# Confirmed current as of 2026-08-19 by checking Meta's docs directly
# (this API version drifts over time); verify it's still current before
# relying on the default in packages/whatsapp/src/client.ts.
# WHATSAPP_API_VERSION="v25.0"

# ── Billing (Stripe) — packages/billing ─────────────────────────────────────
# Stripe dashboard → Developers → API keys. Use a *restricted* or standard
# secret key — this is server-only, never exposed to the client bundle.
STRIPE_SECRET_KEY="[STRIPE_SECRET_KEY]"
# Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Verifies the Stripe-Signature header on every webhook event — this is
# what makes it safe to trust a webhook's claimed customer id without a
# logged-in session (same role WHATSAPP_APP_SECRET plays for Meta).
STRIPE_WEBHOOK_SECRET="[STRIPE_WEBHOOK_SECRET]"
# Price ids (not Product ids) for the two paid plans — Stripe dashboard →
# Product catalog → your product → pricing → copy the price id (starts
# `price_...`). A plan with no price id configured shows as "Not
# configured" in /dashboard/billing rather than a guessed price.
STRIPE_PRICE_STARTER="[STRIPE_PRICE_STARTER]"
STRIPE_PRICE_PRO="[STRIPE_PRICE_PRO]"

# ── Voice (Twilio) — packages/voice ─────────────────────────────────────────
# One platform-level Twilio account handles calls for every tenant's own
# phone number — each Tenant's specific number is set separately, in its
# own Settings page (Tenant.voicePhoneNumber), not here.
# Twilio console → Account → API keys & tokens.
TWILIO_ACCOUNT_SID="[TWILIO_ACCOUNT_SID]"
# Verifies the X-Twilio-Signature header on every voice webhook — this is
# what makes it safe to trust a call's claimed To/From/CallSid without a
# logged-in session.
TWILIO_AUTH_TOKEN="[TWILIO_AUTH_TOKEN]"
# For each tenant's Twilio phone number, set its "A call comes in" webhook
# (Twilio console → Phone Numbers → your number → Voice Configuration) to
# POST https://<your-app-domain>/api/webhooks/voice/incoming — no separate
# env var for this URL, since it's the same app domain the rest of this
# deployment already runs on.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="info"
