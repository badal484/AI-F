generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  OWNER
  ADMIN
  AGENT
}

/// A Lead's position in the sales/conversation pipeline — this IS Phase 3's
/// "Conversation pipeline" (tracking where a prospect's conversation stands),
/// not chat message storage. Chat Conversation/Message tables are built in
/// Phase 4 (Universal Inbox), which is what actually needs them.
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  MANUAL
  REFERRAL
  OTHER
}

enum ConversationChannel {
  WEBSITE
  WHATSAPP
  MANUAL
}

/// HUMAN_REQUIRED is set when the AI (Phase 5) hands a conversation off to
/// staff — MASTER_INSTRUCTIONS.md §5's "Human Handoff" requirement. Phase 4
/// has no AI yet, so it's also settable manually via a "Take over" action.
enum ConversationStatus {
  OPEN
  HUMAN_REQUIRED
  CLOSED
}

/// AI is defined now for Phase 5 forward-compatibility but nothing sets it
/// yet — there is no AI Core in this phase. Only CUSTOMER (staff manually
/// logging what a customer said) and STAFF (an actual reply) are reachable
/// through Phase 4's UI.
enum MessageSender {
  CUSTOMER
  AI
  STAFF
}

/// Agency is the white-label reseller owner sitting above one or more Tenants.
/// Inert until Phase 18 (White-Label / Reseller Architecture) but modeled now
/// so Tenant does not need a breaking schema change later.
model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants Tenant[]

  @@map("agencies")
}

/// A Tenant is one deployed business (a clinic, salon, real estate office, etc.).
/// This is the unit of isolation for every tenant-scoped model.
model Tenant {
  id          String   @id @default(cuid())
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id])
  name        String
  slug        String   @unique
  timezone    String   @default("UTC")
  phone       String?
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  locations          Location[]
  services           Service[]
  staffMembers       StaffMember[]
  customers          Customer[]
  leads              Lead[]
  tags               Tag[]
  conversations      Conversation[]
  messages           Message[]
  knowledgeDocuments KnowledgeDocument[]
  documentChunks     DocumentChunk[]

  @@index([agencyId])
  @@map("tenants")
}

/// A dashboard user (login account) belonging to a Tenant. Authenticated via
/// Supabase Auth; supabaseUserId links this row to the Supabase auth.users
/// record. Distinct from StaffMember, which represents a bookable resource
/// (e.g. a stylist or doctor) — a StaffMember may or may not also be a User.
///
/// TENANT-SCOPED MODEL: every query against User MUST be scoped by tenantId.
/// This is enforced by the Prisma Client Extension in src/tenant.ts — do not
/// query this model through any client other than getTenantDb(tenantId).
model User {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  supabaseUserId String   @unique
  email          String
  name           String?
  role           Role     @default(AGENT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staffMember           StaffMember?
  assignedLeads         Lead[]
  assignedConversations Conversation[]
  sentMessages          Message[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// A physical location a Tenant operates from.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model Location {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String   @default("US")
  phone        String?
  timezone     String   @default("UTC")
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hours        LocationHours[]
  staffMembers StaffMember[]

  @@index([tenantId])
  @@map("locations")
}

/// A Location's regular weekly operating hours. dayOfWeek: 0 = Sunday ... 6 =
/// Saturday. openTime/closeTime are "HH:mm" 24-hour local time strings in the
/// Location's own timezone. isClosed overrides open/close for that day.
///
/// TENANT-SCOPED MODEL — tenantId is denormalized here (not just reachable
/// via Location) so a direct query against this model is still isolated by
/// the Prisma Client Extension without requiring a join.
model LocationHours {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  openTime   String   @default("09:00")
  closeTime  String   @default("17:00")
  isClosed   Boolean  @default(false)

  @@unique([locationId, dayOfWeek])
  @@index([tenantId])
  @@map("location_hours")
}

/// A bookable service the Tenant offers (Phase 7's Booking Engine books
/// Appointments against these).
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model Service {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  currency        String   @default("usd")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("services")
}

/// A bookable resource (e.g. a stylist, doctor, agent) who provides Services.
/// Optionally linked to a User if they also have dashboard login access —
/// most StaffMembers won't, since being bookable doesn't require a login.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model StaffMember {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  name       String
  email      String?
  phone      String?
  title      String?
  photoUrl   String?
  isBookable Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@map("staff_members")
}

/// An identified end-customer of the Tenant's business. A Lead converts into
/// a Customer once qualified/won — see Lead.customerId.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  tags          Tag[]
  conversations Conversation[]

  @@index([tenantId])
  @@map("customers")
}

/// A prospective customer moving through the sales/conversation pipeline
/// (see LeadStage). May optionally already be linked to a Customer record
/// and/or assigned to a dashboard User to work.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model Lead {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  name         String
  email        String?
  phone        String?
  source       LeadSource @default(OTHER)
  stage        LeadStage  @default(NEW)
  valueCents   Int?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tags          Tag[]
  conversations Conversation[]

  @@index([tenantId])
  @@index([customerId])
  @@index([assignedToId])
  @@map("leads")
}

/// A tenant-defined label attachable to Customers and/or Leads.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  customers Customer[]
  leads     Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

/// A conversation thread with a Customer/Lead, over some channel. This is
/// the Universal Inbox's core entity — one row per thread, not per message.
/// "Message assignment" (MASTER_INSTRUCTIONS.md Phase 4) is modeled as
/// assigning the whole Conversation to a dashboard User, matching how
/// helpdesk inboxes assign a thread to an agent.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model Conversation {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  customerId    String?
  customer      Customer?           @relation(fields: [customerId], references: [id])
  leadId        String?
  lead          Lead?               @relation(fields: [leadId], references: [id])
  assignedToId  String?
  assignedTo    User?               @relation(fields: [assignedToId], references: [id])
  channel       ConversationChannel @default(MANUAL)
  status        ConversationStatus  @default(OPEN)
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  messages Message[]

  @@index([tenantId])
  @@index([customerId])
  @@index([leadId])
  @@index([assignedToId])
  @@map("conversations")
}

/// A single message within a Conversation. tenantId is denormalized here
/// (not just reachable via Conversation) for the same reason as
/// LocationHours — direct queries stay isolated without a join.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model Message {
  id             String        @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSender
  senderId       String?
  sender         User?         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([conversationId])
  @@map("messages")
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}

/// A source document for the AI's knowledge base (RAG) — e.g. an FAQ page
/// or policy pasted in by staff. Split into DocumentChunks for embedding;
/// `status`/`error` reflect how that background chunk+embed step went.
///
/// TENANT-SCOPED MODEL — see User's doc comment above; the same rule applies.
model KnowledgeDocument {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  title     String
  content   String
  status    DocumentStatus @default(PENDING)
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  chunks DocumentChunk[]

  @@index([tenantId])
  @@map("knowledge_documents")
}

/// One embeddable slice of a KnowledgeDocument. `embedding` is a pgvector
/// column (1536 dims, matching OpenAI's text-embedding-3-small) — Prisma
/// has no native vector type, so it's declared Unsupported and is
/// COMPLETELY INVISIBLE to the normal Prisma Client API (getTenantDb()'s
/// isolation extension only wraps model methods, not raw SQL). Every read
/// or write of this column goes through packages/db/src/vector.ts's
/// setChunkEmbedding()/searchChunks() instead, which require tenantId as
/// a parameter and bake `tenant_id = ...` into the raw SQL themselves —
/// that requirement, not the extension, is what isolates this column.
///
/// TENANT-SCOPED MODEL (for its normal fields) — see User's doc comment
/// above for those; the embedding column is isolated separately as above.
model DocumentChunk {
  id         String                       @id @default(cuid())
  tenantId   String
  tenant     Tenant                       @relation(fields: [tenantId], references: [id])
  documentId String
  document   KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@index([tenantId])
  @@index([documentId])
  @@map("document_chunks")
}
